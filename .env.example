# 이 파일을 복사해 .env.local 을 만들고 값을 채운다. (.env.local 은 Git에 올라가지 않는다)
# 값은 Supabase 대시보드 > Project Settings > API 에서 확인한다.

# 프로젝트 주소 (예: https://abcdefghijklmn.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_ 로 시작). 예전 프로젝트라면 anon key를 넣어도 된다.
# 브라우저에 노출되어도 되는 키다. service_role / secret key는 절대 넣지 않는다.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 초대 링크를 만들 때 쓰는 사이트 주소. 비워 두면 접속한 주소를 쓴다.
# 예: http://localhost:3000, 배포 후에는 https://실제주소
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# 주민등록번호·계좌번호 암호화 키 (32바이트를 base64로, 44자). 서버에서만 쓰고 브라우저에는 가지 않는다.
# 만드는 법: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# 잃어버리면 저장된 값을 읽을 수 없으니 안전한 곳에 따로 보관한다. (README "암호화 키 만들기")
PII_ENCRYPTION_KEY=
